# Port this service listens on
PORT=5000
NODE_ENV=production

# SMTP provider credentials — never commit real values.
# Zoho Mail example: SMTP_HOST=smtp.zoho.com  SMTP_PORT=465
# Gmail example:      SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (use an App Password, not your account password)
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=<your ZeptoMail Send Mail token>

# Verified sender address in ZeptoMail (SMTP_USER is the literal string
# "emailapikey" for ZeptoMail, not an email — it cannot be used as the From address)
MAIL_FROM=

# Inbox that receives Contact form submissions
MAIL_TO=

# Comma-separated list of origins allowed to call this API (your site's domain in production)
CORS_ORIGIN=https://gemfitech.com

LOG_LEVEL=info

# Shared secret for internal service-to-service calls (e.g. onboarding-service /onboarding-welcome)
INTERNAL_MAIL_SECRET=<shared secret, must match onboarding-service MAIL_SERVICE_SECRET>
